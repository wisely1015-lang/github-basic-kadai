      "source": [
        "array = [\"水\", \"金\", \"地\", \"火\", \"木\", \"土\", \"天\", \"海\", \"冥\"]\n",
        "\n",
        "# forを使った繰り返し\n",
        "for planet in array:\n",
        "    print(planet)\n",
        "\n",
        "# whileを使った繰り返し\n",
        "i = 0\n",
        "while i < len(array):\n",
        "    print(array[i])\n",
        "    i += 1"
      ],
